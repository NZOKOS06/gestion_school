# URL de l'API backend (développement)
VITE_API_URL=http://localhost:3000

# Tenant par défaut pour le mode sans sous-domaine
VITE_DEFAULT_TENANT=demo

# Mode sous-domaine (true = extraction du slug depuis l'URL, false = header X-Tenant-Slug)
VITE_SUBDOMAIN_MODE=false

# Monitoring Sentry (optionnel mais recommandé en prod)
VITE_SENTRY_DSN=https://[key]@sentry.io/[project-id]
