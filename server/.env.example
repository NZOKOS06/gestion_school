# Database
# Local / Docker :
DATABASE_URL="postgresql://postgres:password@localhost:5432/gestschool?schema=public"

# Neon (production) — connexion depuis le dashboard Neon :
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Pour les migrations Prisma sur Neon, préférer l’URL directe (sans -pooler) le temps du migrate,
# ou un job one-off avec l’URL directe.

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# CORS_EXTRA_ORIGINS=
SUBDOMAIN_MODE=false

# Logging
LOG_LEVEL=info  # debug | info | warn | error

# Monitoring Sentry (optionnel mais recommandé en prod)
SENTRY_DSN=https://[key]@sentry.io/[project-id]

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — FRONTEND_URL uniquement en prod (pas de wildcard Vercel).
# Origines supplémentaires explicites, séparées par des virgules :
# CORS_EXTRA_ORIGINS=https://preview-xxx.vercel.app
# Derrière Render : trust proxy activé en production (req.ip = client réel).
# Swagger /api/docs est public en dev, super_admin uniquement en prod.

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=GestSchool <noreply@gestschool.com>

# File Upload
MAX_FILE_SIZE=2097152
UPLOAD_PATH=./uploads

# Cloudinary (stockage images et PDF persistant)
# OBLIGATOIRE en production pour les uploads de fichiers
# Créer un compte gratuit sur cloudinary.com et récupérer ces valeurs
# Dans Render : Dashboard > Service > Environment > ajouter ces 3 variables
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cache Redis (optionnel — fallback mémoire process si absent)
# Docker Compose : redis://redis:6379
# Local : redis://127.0.0.1:6379
REDIS_URL=

# Domaine de production (pour CSP)
DOMAIN=gestschool.com
# CDN si utilisé (optionnel — Cloudinary sert déjà de CDN images)
CDN_URL=

# Security
BCRYPT_ROUNDS=12

# Seed (jamais true en prod sauf bootstrap contrôlé)
# RUN_SEED=true
# ALLOW_PROD_SEED=true   # obligatoire en plus si NODE_ENV=production
# ASSERT_PROD_SOFT=true  # docker local / staging souple

# Default Super Admin (interdit SuperAdmin123! en production)
SUPER_ADMIN_EMAIL=superadmin@gestschool.com
SUPER_ADMIN_PASSWORD=SuperAdmin123!
