generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ==================== MODÈLES CORE ====================

model Tenant {
  id                 String   @id @default(uuid())
  nom                String
  slug               String   @unique
  customDomain       String?
  plan               String   @default("basique") // basique | premium | pro
  actif              Boolean  @default(true)
  numeroAutorisation String?
  pays               String   @default("CG") // CG | CM | CI | SN | CD
  typeEtablissement  String   @default("primaire") // maternelle | primaire | ceg | lycee_general | lycee_technique | lycee_pro | centre_formation | universite
  contact            Json? // {adresse, telephone, email}
  modeMaintenance    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations Core
  config         TenantConfig?
  staff          Staff[]
  users          User[] // Parents connectés
  auditLogs      AuditLog[]
  cookieConsents CookieConsent[]

  // Relations Scolaires
  eleves          Eleve[]
  anneesScolaires AnneeScolaire[]
  classes         Classe[]
  matieres        Matiere[]
  inscriptions    Inscription[]
  echeances       Echeance[]
  evaluations     Evaluation[]
  bulletins       Bulletin[]
  paiements       Paiement[]
  depenses        Depense[]
  emploisDuTemps  EmploiDuTemps[]
  absences        Absence[]
  sanctions       Sanction[]
  certificats     Certificat[]
  notifications   Notification[]
  actualites      Actualite[]
  enseignantClasses EnseignantClasse[]
  salles          Salle[]
  calendrier      CalendrierScolaire[]
  cahierDeTextes  CahierDeTextes[]
  conseils        ConseilDeClasse[]
  messages        Message[]
  heuresEnseignees HeureEnseignee[]
  referentielVersions ReferentielVersion[]
  niveauxOfficiels  NiveauOfficiel[]
  filieresOfficielles FiliereOfficielle[]
  periodesScolaires PeriodeScolaire[]
  examenSessions    ExamenSession[]
  examenCandidatures ExamenCandidature[]
  resultatsExamens  ResultatExamen[]
  matieresNiveauAnnee MatiereNiveauAnnee[]
  matieresClasseAnnee MatiereClasseAnnee[]
  enseignantClassesQuittees EnseignantClasseQuittee[]

  @@index([slug])
}

model TenantConfig {
  id                 String  @id @default(uuid())
  tenantId           String  @unique
  nomEcole           String  @default("GestSchool")
  slogan             String?
  logoUrl            String?
  faviconUrl         String?
  backgroundImageUrl String?
  loaderUrl          String?

  // Personnalisation Graphique (Thème White-label)
  couleurPrimaire   String  @default("#1e3a8a") // Bleu académique par défaut
  couleurSecondaire String  @default("#0d9488")
  couleurTexte      String  @default("#1f2937")
  couleurAlerte     String  @default("#f59e0b")
  couleurErreur     String  @default("#ef4444")
  couleurSucces     String  @default("#22c55e")
  darkModeDefault   Boolean @default(false)
  police            String  @default("Plus Jakarta Sans")

  // Coordonnées Établissement
  adresse        String?
  telephone      String?
  email          String?
  devise         String  @default("FCFA")
  messageAccueil String?

  // Paramétrage Pédagogique
  anneeScolaireActiveId String? // Id de l'AnneeScolaire en cours
  notationSur           Int     @default(20) // Notes sur 20 ou sur 100
  seuilReussite         Decimal @default(10.00) @db.Decimal(5, 2) // Moyenne minimale pour passer
  nombrePeriodes        Int     @default(3) // 3 pour Trimestres, 2 pour Semestres
  conventionPeriode     String  @default("trimestre") // trimestre | semestre
  joursEcole            TenantJourEcole[]
  heureDebut            String  @default("08:00")
  heureFin              String  @default("17:00")

  // Paramétrage Financier
  fraisInscriptionDefault Decimal @default(0.00) @db.Decimal(12, 2)
  fraisScolariteDefault   Decimal @default(0.00) @db.Decimal(12, 2)

  // Modules SaaS — défauts alignés gel V1 (voir server/src/config/v1Modules.js)
  moduleNotes         Boolean @default(true)
  moduleBulletins     Boolean @default(true)
  modulePresences     Boolean @default(false)
  modulePaiements     Boolean @default(true)
  moduleEmploiDuTemps Boolean @default(false)
  moduleParents       Boolean @default(false)
  moduleEleves        Boolean @default(true)
  moduleSanctions     Boolean @default(false)
  moduleBiblio        Boolean @default(false)
  moduleCantine       Boolean @default(false)
  moduleTransport     Boolean @default(false)
  moduleCertificats   Boolean @default(false)
  moduleClasses       Boolean @default(true)
  moduleInscriptions  Boolean @default(true)
  modulePersonnel     Boolean @default(true)
  moduleRapports      Boolean @default(true)

  // Sécurité & sessions
  dureeSessionMinutes Int     @default(480)
  ipWhitelist         TenantIpWhitelist[]
  forcer2FA           Boolean @default(false)

  // RGPD / consentement
  privacyPolicyUrl    String?
  termsOfServiceUrl   String?
  cookiePolicyUrl     String?
  cookieBannerText    String?
  cookieBannerEnabled Boolean @default(true)
  analyticsEnabled    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantJourEcole {
  id           String       @id @default(uuid())
  tenantId     String
  jour         String
  tenantConfig TenantConfig @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  @@unique([tenantId, jour])
}

model TenantIpWhitelist {
  id           String       @id @default(uuid())
  tenantId     String
  ip           String
  tenantConfig TenantConfig @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  @@unique([tenantId, ip])
}

model Staff {
  id                 String    @id @default(uuid())
  tenantId           String
  email              String
  emailVerified      Boolean   @default(false)
  passwordHash       String
  role               StaffRole
  nom                String
  prenom             String
  telephone          String?
  typeContrat        TypeContrat @default(titulaire) // titulaire | vacataire | stagiaire | contractuel
  heuresHebdo        Int?      // Cahier de charge — heures par semaine (pour vacataires)
  tauxHoraire        Decimal?  @db.Decimal(10, 2) // Taux horaire pour vacataires
  mustChangePassword Boolean   @default(true)
  actif              Boolean   @default(true)
  derniereConnexion  DateTime?
  lastIp             String?
  lastUserAgent      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations pédagogiques spécifiques
  enseignantClasses EnseignantClasse[]
  classesQuittees   EnseignantClasseQuittee[]
  emploisDuTemps    EmploiDuTemps[]
  paiementsRecus    Paiement[]         @relation("RecuPar")
  depensesSaisies   Depense[]          @relation("DepenseSaisiePar")
  certificatsDelivres Certificat[]     @relation("DelivrePar")
  notesSaisies      Note[]             @relation("SaisiPar")
  absencesSaisies   Absence[]          @relation("SaisiPar")
  notifications     Notification[]     @relation("StaffDestinataire")
  cahierDeTextes    CahierDeTextes[]
  heuresEnseignees  HeureEnseignee[]
  messagesEnvoyes   Message[]          @relation("MessageExpediteur")
  messagesRecus     Message[]          @relation("MessageDestinataireStaff")
  conseilParticipants ConseilParticipant[]
  conseilsPresides  ConseilDeClasse[]  @relation("ConseilPresident")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([role])
}

model User {
  id                String    @id @default(uuid())
  tenantId          String
  email             String
  emailVerified     Boolean   @default(false)
  passwordHash      String?
  nom               String
  prenom            String
  telephone         String?
  adresse           String?
  actif             Boolean   @default(true)
  derniereConnexion DateTime?
  lastIp            String?
  lastUserAgent     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Un parent peut avoir plusieurs enfants (élèves) dans l'école
  enfants Eleve[]

  // Notifications destinées au parent
  notifications Notification[] @relation("UserDestinataire")

  // Messagerie
  messagesRecus Message[] @relation("MessageDestinataireUser")
  messagesEnvoyes Message[] @relation("MessageExpediteurUser")

  @@unique([tenantId, email])
  @@index([tenantId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  userType  String    @default("staff") // staff | parent
  tenantId  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([tenantId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  userType  String    @default("staff") // staff | parent
  tenantId  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([tenantId])
}

model CookieConsent {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  sessionId String?
  necessary Boolean  @default(true)
  analytics Boolean  @default(false)
  marketing Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sessionId])
  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([sessionId])
}

// ==================== MODÈLES MÉTIER SCOLAIRES ====================

model AnneeScolaire {
  id        String   @id @default(uuid())
  tenantId  String
  libelle   String // ex: "2025-2026"
  dateDebut DateTime
  dateFin   DateTime
  actif     Boolean  @default(false) // Une seule année active/tenant (index unique partiel SQL)
  statut    StatutAnneeScolaire @default(brouillon)
  referentielVersionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referentielVersion ReferentielVersion? @relation(fields: [referentielVersionId], references: [id], onDelete: SetNull)

  classes      Classe[]
  inscriptions Inscription[]
  bulletins    Bulletin[]
  evaluations  Evaluation[]
  certificats  Certificat[]
  calendrier   CalendrierScolaire[]
  conseils     ConseilDeClasse[]
  periodes     PeriodeScolaire[]
  examenSessions ExamenSession[]
  matieresNiveauAnnee MatiereNiveauAnnee[]

  @@unique([tenantId, libelle])
  @@index([tenantId])
  @@index([actif])
  @@index([statut])
  @@index([referentielVersionId])
}

model ReferentielVersion {
  id        String   @id @default(uuid())
  tenantId  String
  code      String // cg_actuel | cg_reforme_2026
  libelle   String
  actif     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  niveaux NiveauOfficiel[]
  filieres FiliereOfficielle[]
  annees  AnneeScolaire[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model NiveauOfficiel {
  id                   String            @id @default(uuid())
  tenantId             String
  referentielVersionId String
  code                 String // PS, CM2, 6e, Tle
  libelle              String
  cycle                CycleEnseignement
  ordre                Int
  ageIndicatif         Int?
  typeExamenSortie     TypeExamenCode? // CEPE, BEPC, BAC_GENERAL…
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referentielVersion   ReferentielVersion @relation(fields: [referentielVersionId], references: [id], onDelete: Cascade)
  classes              Classe[]
  inscriptionsCible    Inscription[]      @relation("InscriptionNiveauCible")
  matieresNiveauAnnee  MatiereNiveauAnnee[]

  @@unique([referentielVersionId, code])
  @@index([tenantId])
  @@index([cycle])
}

model FiliereOfficielle {
  id                   String             @id @default(uuid())
  tenantId             String
  referentielVersionId String
  code                 String
  libelle              String
  cycle                CycleEnseignement  @default(lycee)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referentielVersion ReferentielVersion @relation(fields: [referentielVersionId], references: [id], onDelete: Cascade)
  classes            Classe[]

  @@unique([referentielVersionId, code])
  @@index([tenantId])
}

model PeriodeScolaire {
  id                   String   @id @default(uuid())
  tenantId             String
  anneeScolaireId      String
  index                Int // 1, 2, 3 (trimestres) ou 10+ (mois)
  libelle              String // 1er trimestre / Octobre
  dateDebut            DateTime
  dateFin              DateTime
  dateEvaluationDebut  DateTime?
  dateEvaluationFin    DateTime?
  poids                Decimal? @db.Decimal(5, 2)
  /// null = tous les cycles ; sinon ex. ["prescolaire","primaire"]
  concerneCycles       Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)

  @@unique([anneeScolaireId, index])
  @@index([tenantId])
  @@index([anneeScolaireId])
}

model Classe {
  id              String   @id @default(uuid())
  tenantId        String
  anneeScolaireId String
  nom             String // ex: "6ème A", "Terminale S1"
  niveau          String // ex: "6eme", "terminale" (compat / affichage)
  cycle           CycleEnseignement
  filiere         String?
  niveauOfficielId String?
  filiereOfficielleId String?
  capacite        Int      @default(40)
  fraisScolarite  Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
  niveauOfficiel NiveauOfficiel? @relation(fields: [niveauOfficielId], references: [id], onDelete: SetNull)
  filiereOfficielle FiliereOfficielle? @relation(fields: [filiereOfficielleId], references: [id], onDelete: SetNull)

  inscriptions   Inscription[]
  enseignants    EnseignantClasse[]
  enseignantsQuittes EnseignantClasseQuittee[]
  evaluations    Evaluation[]
  emploisDuTemps EmploiDuTemps[]
  matieresClasseAnnee MatiereClasseAnnee[]
  bulletins      Bulletin[]
  cahierDeTextes CahierDeTextes[]
  conseils       ConseilDeClasse[]
  heuresEnseignees HeureEnseignee[]
  inscriptionsCible Inscription[] @relation("InscriptionClasseCible")

  @@unique([tenantId, anneeScolaireId, nom])
  @@index([tenantId])
  @@index([anneeScolaireId])
  @@index([cycle])
  @@index([niveauOfficielId])
}

model Matiere {
  id          String   @id @default(uuid())
  tenantId    String
  nom         String // ex: "Mathématiques", "Histoire-Géographie"
  code        String // ex: "MATH", "HIST-GEO"
  coefficient Int      @default(1)
  description String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  evaluations     Evaluation[]
  emploisDuTemps  EmploiDuTemps[]
  enseignantClasses EnseignantClasse[]
  cahierDeTextes  CahierDeTextes[]
  heuresEnseignees HeureEnseignee[]
  matieresNiveauAnnee MatiereNiveauAnnee[]
  matieresClasseAnnee MatiereClasseAnnee[]
  bulletinDetails BulletinDetail[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Programme matière par niveau officiel + année (coef de référence)
model MatiereNiveauAnnee {
  id                String  @id @default(uuid())
  tenantId          String
  anneeScolaireId   String
  niveauOfficielId  String
  matiereId         String
  coefficient       Int     @default(1)
  actif             Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  anneeScolaire    AnneeScolaire   @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
  niveauOfficiel   NiveauOfficiel  @relation(fields: [niveauOfficielId], references: [id], onDelete: Cascade)
  matiere          Matiere         @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([anneeScolaireId, niveauOfficielId, matiereId])
  @@index([tenantId])
  @@index([anneeScolaireId])
  @@index([niveauOfficielId])
}

/// Surcharge / ajout matière pour une classe concrète (année portée par la classe)
model MatiereClasseAnnee {
  id           String  @id @default(uuid())
  tenantId     String
  classeId     String
  matiereId    String
  coefficient  Int?
  actif        Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classe  Classe  @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([classeId, matiereId])
  @@index([tenantId])
  @@index([classeId])
}

model Eleve {
  id            String   @id @default(uuid())
  tenantId      String
  parentId      String? // Relation vers le Parent (User) connecté
  matricule     String   @unique // Code unique global ex: "GS-2026-0089"
  nom           String
  prenom        String
  dateNaissance DateTime
  lieuNaissance String?
  sexe          String // "M" | "F"
  adresse       String?
  photoUrl      String?
  actif         Boolean  @default(true)
  dateEntree    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent User?  @relation(fields: [parentId], references: [id], onDelete: SetNull)

  inscriptions Inscription[]
  notes        Note[]
  bulletins    Bulletin[]
  absences     Absence[]
  sanctions    Sanction[]
  certificats  Certificat[]
  examenCandidatures ExamenCandidature[]

  @@index([tenantId])
  @@index([matricule])
  @@index([nom, prenom])
}

model EnseignantClasse {
  // Liaison Staff(enseignant) ↔ Classe ↔ Matiere
  // Un enseignant enseigne UNE matière dans UNE classe
  id           String @id @default(uuid())
  tenantId     String
  enseignantId String // Référence à Staff (rôle enseignant)
  classeId     String
  matiereId    String

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enseignant  Staff       @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  classe      Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere     Matiere     @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([enseignantId, classeId, matiereId])
  @@index([tenantId])
  @@index([classeId])
  @@index([matiereId])
}

model EnseignantClasseQuittee {
  // Classe retirée à un enseignant par la direction : le retour y est définitivement fermé
  id           String   @id @default(uuid())
  tenantId     String
  enseignantId String
  classeId     String
  motif        String?
  dateSortie   DateTime @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enseignant Staff  @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  classe     Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)

  @@unique([enseignantId, classeId])
  @@index([tenantId])
  @@index([classeId])
}

model Inscription {
  id              String            @id @default(uuid())
  tenantId        String
  eleveId         String
  classeId        String
  anneeScolaireId String
  dateInscription DateTime          @default(now())
  statut          StatutInscription @default(validee)
  decisionFinAnnee DecisionFinAnnee?
  niveauCibleId   String?
  classeCibleId   String?
  motifDecision   String?
  resultatExamenId String?
  soldeScolarite  Decimal           @default(0.00) @db.Decimal(12, 2)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eleve         Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  classe        Classe        @relation(fields: [classeId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
  niveauCible   NiveauOfficiel? @relation("InscriptionNiveauCible", fields: [niveauCibleId], references: [id], onDelete: SetNull)
  classeCible   Classe?         @relation("InscriptionClasseCible", fields: [classeCibleId], references: [id], onDelete: SetNull)
  resultatExamen ResultatExamen? @relation(fields: [resultatExamenId], references: [id], onDelete: SetNull)

  paiements  Paiement[]
  echeances  Echeance[]

  @@unique([tenantId, anneeScolaireId, eleveId])
  @@index([tenantId])
  @@index([eleveId])
  @@index([classeId])
  @@index([anneeScolaireId])
}

model Echeance {
  // Tranche de paiement liée à une Inscription
  // Indispensable pour les relances automatiques d'impayés
  id              String         @id @default(uuid())
  tenantId        String
  inscriptionId   String
  libelle         String // ex: "Tranche 1", "Frais d'inscription"
  montantAttendu  Decimal        @db.Decimal(12, 2)
  dateEcheance    DateTime // Date limite de paiement
  montantPaye     Decimal        @default(0.00) @db.Decimal(12, 2)
  statut          StatutEcheance @default(en_attente)
  lastRelanceAt   DateTime? // Dernière relance email (throttle cron)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inscription Inscription @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  paiements   Paiement[]

  @@index([tenantId])
  @@index([inscriptionId])
  @@index([statut])
  @@index([dateEcheance])
}

model Evaluation {
  id              String         @id @default(uuid())
  tenantId        String
  classeId        String
  matiereId       String
  anneeScolaireId String
  periodeIndex    Int // Trimestre 1, 2, 3 ou Semestre 1, 2
  nom             String // ex: "Devoir de Table n°1"
  type            TypeEvaluation @default(devoir)
  dateEvaluation  DateTime
  coefficient     Int            @default(1)
  noteMaximale    Decimal        @default(20.00) @db.Decimal(5, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classe        Classe        @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere       Matiere       @relation(fields: [matiereId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)

  notes Note[]

  @@index([tenantId])
  @@index([classeId, matiereId])
  @@index([anneeScolaireId])
}

model Note {
  id           String   @id @default(uuid())
  tenantId     String
  eleveId      String
  evaluationId String
  valeur       Decimal  @db.Decimal(5, 2) // La note obtenue (ex: 14.50)
  appreciation String? // Commentaire de l'enseignant (ex: "Très bon travail")
  saisiParId   String? // Id de l'enseignant (Staff)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  eleve      Eleve      @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  saisiPar   Staff?     @relation("SaisiPar", fields: [saisiParId], references: [id], onDelete: SetNull)

  @@unique([eleveId, evaluationId]) // Un élève a une seule note par évaluation
  @@index([tenantId])
  @@index([eleveId])
  @@index([evaluationId])
}

model Bulletin {
  id              String         @id @default(uuid())
  tenantId        String
  eleveId         String
  classeId        String
  anneeScolaireId String
  periodeIndex    Int // 1 = 1er Trimestre / Semestre
  moyenneGenerale Decimal        @db.Decimal(5, 2)
  rang            Int
  effectifClasse  Int
  mention         MentionBulletin @default(aucune)
  decisionConseil String? // ex: "Passage au niveau supérieur", "Avertissement travail"
  absencesHeures  Int      @default(0)
  notesDetaillees BulletinDetail[]
  pdfUrl          String? // Copie archivée sur Cloudinary du bulletin généré
  qrCodeHash      String?  @unique // Hash anti-falsification pour vérification QR code
  valide          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eleve         Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  classe        Classe        @relation(fields: [classeId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)

  @@unique([tenantId, anneeScolaireId, classeId, periodeIndex, eleveId])
  @@index([tenantId])
  @@index([eleveId])
  @@index([classeId])
  @@index([anneeScolaireId])
}

model BulletinDetail {
  id          String   @id @default(uuid())
  bulletinId  String
  matiereId   String
  moyenne     Decimal  @db.Decimal(5, 2)
  bulletin    Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  matiere     Matiere  @relation(fields: [matiereId], references: [id])
  @@unique([bulletinId, matiereId])
}

model EmploiDuTemps {
  id           String   @id @default(uuid())
  tenantId     String
  classeId     String
  matiereId    String
  enseignantId String // Staff (role: enseignant)
  salleId      String? // Lien vers Salle (optionnel)
  jourSemaine  Int // 1=Lundi, 2=Mardi... 7=Dimanche
  heureDebut   String // format "HH:MM" (ex: "08:00")
  heureFin     String // format "HH:MM" (ex: "10:00")
  salle        String? // Nom ou numéro de la salle (legacy, remplacé par salleId)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classe     Classe  @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere    Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)
  enseignant Staff   @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  salleRef   Salle?  @relation(fields: [salleId], references: [id], onDelete: SetNull)

  absences Absence[]
  cahierDeTextes CahierDeTextes[]

  @@index([tenantId])
  @@index([classeId])
  @@index([enseignantId])
  @@index([jourSemaine])
  @@index([salleId])
}

model Absence {
  id              String   @id @default(uuid())
  tenantId        String
  eleveId         String
  emploiDuTempsId String? // Lié au cours manqué
  dateAbsence     DateTime @default(now())
  typeAbsence     TypeAbsence @default(absent) // absent | retard | depart_anticipe
  justifiee       Boolean  @default(false)
  motifJustif     String? // Justification médicale ou parentale
  pieceJustifUrl  String? // Image d'un mot de médecin ou document justificatif
  saisieParId     String? // Surveillant ou Enseignant qui a fait l'appel
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eleve         Eleve          @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  emploiDuTemps EmploiDuTemps? @relation(fields: [emploiDuTempsId], references: [id], onDelete: SetNull)
  saisiePar     Staff?         @relation("SaisiPar", fields: [saisieParId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([eleveId])
  @@index([dateAbsence])
}

model Sanction {
  id           String       @id @default(uuid())
  tenantId     String
  eleveId      String
  type         TypeSanction
  motif        String
  dureeJours   Int? // Durée en jours en cas d'exclusion
  dateSanction DateTime     @default(now())
  validee      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eleve  Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eleveId])
  @@index([type])
}

model Paiement {
  id            String       @id @default(uuid())
  tenantId      String
  inscriptionId String
  echeanceId    String? // Lien optionnel vers une échéance spécifique
  recuParId     String // Comptable / caissier qui a perçu les fonds
  numeroRecu    Int // Auto-incrémenté par tenant pour l'impression
  montant       Decimal      @db.Decimal(12, 2)
  typePaiement  TypePaiement @default(scolarite)
  modePaiement  ModePaiement
  reference     String? // ID de transaction Mobile Money, chèque ou virement
  datePaiement  DateTime     @default(now())
  motif         String? // ex: "Frais de Scolarité - Tranche 1"
  pdfUrl        String? // Reçu PDF archivé (Cloudinary) ou null
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inscription Inscription @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  echeance    Echeance?   @relation(fields: [echeanceId], references: [id], onDelete: SetNull)
  recuPar     Staff       @relation("RecuPar", fields: [recuParId], references: [id])

  @@unique([tenantId, numeroRecu])
  @@index([tenantId])
  @@index([inscriptionId])
  @@index([echeanceId])
  @@index([datePaiement])
}

model Depense {
  id          String   @id @default(uuid())
  tenantId    String
  categorie   String
  montant     Decimal  @db.Decimal(12, 2)
  motif       String
  reference   String?
  dateDepense DateTime @default(now())
  saisieParId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saisiePar Staff  @relation("DepenseSaisiePar", fields: [saisieParId], references: [id])

  @@index([tenantId])
  @@index([dateDepense])
  @@index([categorie])
}

model Certificat {
  // Certificats et attestations délivrés aux élèves
  id              String          @id @default(uuid())
  tenantId        String
  eleveId         String
  anneeScolaireId String?
  type            TypeCertificat
  numeroSerie     String // Numéro unique par tenant pour traçabilité
  pdfUrl          String? // Copie archivée sur Cloudinary
  delivreParId    String // Staff qui a délivré le certificat
  valide          Boolean         @default(true)
  dateDelivrance  DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eleve         Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire? @relation(fields: [anneeScolaireId], references: [id], onDelete: SetNull)
  delivrePar    Staff         @relation("DelivrePar", fields: [delivreParId], references: [id])

  @@unique([tenantId, numeroSerie])
  @@index([tenantId])
  @@index([eleveId])
  @@index([type])
}

model Notification {
  // Persistance des alertes Socket.IO quand l'utilisateur est hors ligne
  id        String            @id @default(uuid())
  tenantId  String
  userId    String? // Destinataire = Parent (User)
  staffId   String? // Destinataire = Staff
  type      TypeNotification
  titre     String
  contenu   String
  lu        Boolean           @default(false)
  lien      String? // Lien d'action (ex: "/bulletins/123")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation("UserDestinataire", fields: [userId], references: [id], onDelete: Cascade)
  staff  Staff? @relation("StaffDestinataire", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([staffId])
  @@index([lu])
  @@index([createdAt])
}

model Actualite {
  id        String   @id @default(uuid())
  tenantId  String
  titre     String
  contenu   String   @db.Text
  publique  Boolean  @default(false) // true = visible sur le site vitrine
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([publique])
}

// ==================== ENUMS ====================

