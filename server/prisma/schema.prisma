  note
  absence
  sanction
  paiement
  bulletin
  actualite
  message
  relance_impaye
  systeme
  evenement
}

// ==================== MODÈLE AUDIT ====================

model AuditLog {
  id         String      @id @default(uuid())
  tenantId   String? // optionnel pour actions globales (superadmin)
  actorId    String? // staffId ou userId qui a fait l'action
  actorRole  String? // rôle de l'acteur au moment de l'action
  action     String // ex: login, affectation_created, paiement_encaisse…
  targetType String? // ex: Staff, Tenant, Eleve, Note, Paiement...
  targetId   String? // ID de l'entité ciblée
  details    Json? // données contextuelles (ancien rôle, nouveau rôle, etc.)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}

// ==================== NOUVEAUX MODÈLES MÉTIER ====================

enum TypeAbsence {
  absent
  retard
  depart_anticipe
}

enum DecisionFinAnnee {
  passage
  redoublement
  orientation
  exclusion
}

enum TypeContrat {
  titulaire
  vacataire
  stagiaire
  contractuel
}

enum TypeEvenementCalendrier {
  rentree
  vacances
  examen
  jour_ferie
  conseil_classe
  evenement_scolaire
  composition
  reprise_cours
}

// --- Salle de cours ---
model Salle {
  id        String   @id @default(uuid())
  tenantId  String
  nom       String   // ex: "A12", "Labo Sciences"
  batiment  String?
  capacite  Int      @default(40)
  type      String   @default("cours") // cours | labo | informatique | sport | reunion
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emploisDuTemps EmploiDuTemps[]

  @@unique([tenantId, nom])
  @@index([tenantId])
}

// --- Calendrier scolaire ---
model CalendrierScolaire {
  id              String                @id @default(uuid())
  tenantId        String
  anneeScolaireId String
  titre           String                // ex: "Rentrée scolaire", "Vacances de Noël", "Composition 1er trimestre"
  type            TypeEvenementCalendrier
  dateDebut       DateTime
  dateFin         DateTime?
  description     String?
  concerneCycles  Json?                 // ex: ["primaire", "college"] — null = tous les cycles
  alerteEnvoyeeAt DateTime?             // Horodatage de l'alerte J-14 (idempotence)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([anneeScolaireId])
  @@index([type])
  @@index([dateDebut])
}

// --- Cahier de textes (obligatoire pour l'inspection) ---
model CahierDeTextes {
  id           String   @id @default(uuid())
  tenantId     String
  enseignantId String   // Staff (role: enseignant)
  classeId     String
  matiereId    String
  emploiDuTempsId String? // Lien optionnel vers le créneau de cours
  dateCours    DateTime
  lecon        String   @db.Text // Contenu de la leçon enseignée
  devoirsDonnes String? @db.Text // Devoirs donnés aux élèves
  observations String?  // Remarques pédagogiques
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enseignant  Staff       @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  classe      Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiere     Matiere     @relation(fields: [matiereId], references: [id], onDelete: Cascade)
  emploiDuTemps EmploiDuTemps? @relation(fields: [emploiDuTempsId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([enseignantId])
  @@index([classeId])
  @@index([matiereId])
  @@index([dateCours])
}

// --- Conseil de classe (processus collectif formel) ---
model ConseilDeClasse {
  id              String   @id @default(uuid())
  tenantId        String
  classeId        String
  anneeScolaireId String
  periodeIndex    Int      // Trimestre/Semestre concerné
  dateConseil     DateTime
  presidentId     String   // Staff (généralement le directeur ou surveillant général)
  compteRendu     String?  @db.Text // Compte-rendu général de la réunion
  cloture         Boolean  @default(false) // true = décisions figées et bulletins validés
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classe        Classe        @relation(fields: [classeId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
  president     Staff         @relation("ConseilPresident", fields: [presidentId], references: [id], onDelete: Cascade)

  participants ConseilParticipant[]

  @@unique([tenantId, anneeScolaireId, classeId, periodeIndex])
  @@index([tenantId])
  @@index([classeId])
  @@index([anneeScolaireId])
}

model ConseilParticipant {
  id           String @id @default(uuid())
  conseilId    String
  staffId      String
  present      Boolean @default(true)
  observations String?

  conseil     ConseilDeClasse @relation(fields: [conseilId], references: [id], onDelete: Cascade)
  staff       Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([conseilId, staffId])
  @@index([conseilId])
}

// --- Heures enseignées (pour la paie des vacataires) ---
model HeureEnseignee {
  id           String   @id @default(uuid())
  tenantId     String
  enseignantId String   // Staff (role: enseignant, typeContrat: vacataire)
  classeId     String?
  matiereId    String?
  date         DateTime
  heureDebut   String   // "HH:MM"
  heureFin     String   // "HH:MM"
  dureeHeures  Decimal  @db.Decimal(5, 2) // Durée calculée en heures
  validee      Boolean  @default(false) // Validée par la direction pour la paie
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enseignant  Staff    @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  classe      Classe?  @relation(fields: [classeId], references: [id], onDelete: SetNull)
  matiere     Matiere? @relation(fields: [matiereId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([enseignantId])
  @@index([date])
  @@index([validee])
}

// --- Messagerie interne ---
model Message {
  id           String   @id @default(uuid())
  tenantId     String
  expediteurId String?  // Staff qui envoie (null si parent)
  expediteurUserId String? // Parent qui envoie (null si staff)
  destinataireStaffId String? // Staff destinataire (si staff ↔ staff)
  destinataireUserId  String? // User (parent) destinataire (si staff ↔ parent)
  sujet        String
  contenu      String   @db.Text
  lu           Boolean  @default(false)
  dateLecture  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant              Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expediteur          Staff?  @relation("MessageExpediteur", fields: [expediteurId], references: [id], onDelete: Cascade)
  expediteurUser      User?   @relation("MessageExpediteurUser", fields: [expediteurUserId], references: [id], onDelete: Cascade)
  destinataireStaff   Staff?  @relation("MessageDestinataireStaff", fields: [destinataireStaffId], references: [id], onDelete: Cascade)
  destinataireUser    User?   @relation("MessageDestinataireUser", fields: [destinataireUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expediteurId])
  @@index([expediteurUserId])
  @@index([destinataireStaffId])
  @@index([destinataireUserId])
  @@index([lu])
  @@index([createdAt])
}

// ==================== EXAMENS NATIONAUX (Congo) ====================

enum TypeExamenCode {
  CEPE
  BEPC
  BAC_GENERAL
  BAC_TECHNIQUE
  CAP
  BEP
  BTS
  CONCOURS_6E
  AUTRE
}

enum ResultatExamenStatut {
  admis
  ajourne
  refuse
  en_attente
}

model ExamenSession {
  id              String         @id @default(uuid())
  tenantId        String
  anneeScolaireId String
  typeExamen      TypeExamenCode
  libelle         String
  dateDebut       DateTime?
  dateFin         DateTime?
  centre          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
  candidatures  ExamenCandidature[]

  @@index([tenantId])
  @@index([anneeScolaireId])
  @@index([typeExamen])
}

model ExamenCandidature {
  id             String   @id @default(uuid())
  tenantId       String
  sessionId      String
  eleveId        String
  serieFiliere   String?
  numeroCandidat String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session  ExamenSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eleve    Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  notes    ExamenNote[]
  resultat ResultatExamen?

  @@unique([sessionId, eleveId])
  @@index([tenantId])
  @@index([eleveId])
}

model ExamenNote {
  id             String  @id @default(uuid())
  candidatureId  String
  matiereLibelle String
  note           Decimal @db.Decimal(5, 2)
  coefficient    Decimal @default(1) @db.Decimal(5, 2)

  candidature ExamenCandidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)

  @@index([candidatureId])
}

model ResultatExamen {
  id            String               @id @default(uuid())
  tenantId      String
  candidatureId String               @unique
  statut        ResultatExamenStatut @default(en_attente)
  mention       String?
  numeroDiplome String?
  moyenne       Decimal?             @db.Decimal(5, 2)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidature  ExamenCandidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  inscriptions Inscription[]

  @@index([tenantId])
  @@index([statut])
}
