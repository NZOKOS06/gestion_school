  super_admin
  directeur
  directeur_etudes // Directeur des études (pédagogie)
  secretaire
  enseignant
  surveillant
  comptable // Gestionnaire financier / caisse
}

enum CycleEnseignement {
  prescolaire
  primaire
  college
  lycee
}

enum StatutInscription {
  en_attente
  validee
  annulee
  suspendue
}

enum StatutAnneeScolaire {
  brouillon
  active
  archivee
}

enum StatutEcheance {
  en_attente
  payee
  en_retard
  annulee
}

enum TypeEvaluation {
  devoir
  interrogation
  examen
  rattrapage
  pratique // TP, stage pour filières technique et pro
}

