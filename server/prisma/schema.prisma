}

enum TypePaiement {
  inscription
  scolarite
  mensualite
  examen_officiel
  bibliotheque
  cantine
  transport
  uniforme
  autre
}

enum ModePaiement {
  especes
  mobile_money // Orange Money, MTN MoMo, Airtel Money
  carte
  cheque
  virement
}

enum TypeSanction {
  avertissement
  blame
  retenue
  exclusion_temporaire
  exclusion_definitive
}

enum TypeCertificat {
  scolarite
  inscription
  fin_etudes
  attestation_inscription
  releve_notes
  carte_scolaire
  convocation_examen
  autre
}

