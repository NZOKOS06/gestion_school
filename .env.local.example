# ============================================================
# GestSchool — Configuration Physique Locale
# Copiez ce fichier en .env.local et adaptez les valeurs
# ============================================================

# ── Base de données ────────────────────────────────────────
DB_PASSWORD=GestSchool2025!

# ── Secrets JWT (utilisez des chaînes longues et aléatoires)
# Générez avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REMPLACEZ_PAR_UNE_CHAINE_ALEATOIRE_DE_64_CHARS
JWT_REFRESH_SECRET=REMPLACEZ_PAR_UNE_AUTRE_CHAINE_ALEATOIRE_64_CHARS

# ── URL du frontend ────────────────────────────────────────
# En mode LAN : mettez l'IP locale du PC serveur, ex: http://192.168.1.100
FRONTEND_URL=http://localhost

# ── Port HTTP (80 = standard, 8080 si problème de droits) ──
HTTP_PORT=80

# ── Premier lancement uniquement ──────────────────────────
# Mettre "true" pour initialiser les données de démo, puis repasser à "false"
RUN_SEED=false

# ── Email (optionnel — laisser vide si pas de SMTP) ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=gestschool@ecole.local
